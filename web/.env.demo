# `vite build --mode demo` (npm run demo): the public site with its backend
# inside the browser (src/demo/shim.js). Committed on purpose: nothing here is
# a secret. The API host is pretend and never reached; the photos are files
# published beside the page.
VITE_SUPABASE_URL=https://demo.invalid
VITE_SUPABASE_ANON_KEY=demo
VITE_STORAGE_URL=.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PUBLIC_URL=
VITE_IMAGE_TRANSFORMS=false
VITE_MOCK_CHECKOUT=true
VITE_TURNSTILE_SITE_KEY=

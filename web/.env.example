# Copy to web/.env.local for development. Everything here is PUBLIC: Vite
# bakes VITE_* values into the JavaScript every reader downloads. Never put a
# secret key (service role, sk_live_, whsec_) in this file.
#
# Local stack: run `supabase status -o env` in the repo root and copy API_URL
# and ANON_KEY (or PUBLISHABLE_KEY) from its output.

# Supabase project URL. Local: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Supabase anon (or publishable) key. Safe to publish: row level security and
# column grants decide what it can read, and it can write nothing.
VITE_SUPABASE_ANON_KEY=

# Stripe PUBLISHABLE key (pk_test_... / pk_live_...) from the contest's own
# Stripe account, not WPR's donation account. Empty = checkout shows a
# "not switched on yet" notice instead of the payment form.
VITE_STRIPE_PUBLISHABLE_KEY=

# The WordPress page that embeds the contest, e.g.
# https://wausaupilotandreview.com/pet-contest/
# Share links and the share-page redirects point here. Empty = the app's own URL.
VITE_PUBLIC_URL=

# "true" only if the Supabase plan includes image transformations
# (/storage/v1/render/image). Otherwise leave empty: raw photos are served,
# which the upload step has already resized to 2048px.
VITE_IMAGE_TRANSFORMS=

# Optional. Absolute URL where this build is served (GitHub Pages), used for
# og:url / og:image and the per-pet share pages. In GitHub Actions it is
# derived from the repository name; set it for a custom domain.
# VITE_SITE_URL=https://rowanflynnpilot.github.io/wpr-pet-contest/

# Edge function settings for the integration suite, local and CI. Placeholders
# only: nothing here is a real key, and the suite never reaches Stripe's API
# successfully (it asserts that checkout gets as far as trying).
#
#   supabase functions serve --env-file supabase/tests/integration/functions.env
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
STRIPE_SECRET_KEY=sk_test_placeholder_for_integration_tests
STRIPE_WEBHOOK_SECRET=whsec_integration_test_secret
PUBLIC_URL=http://localhost:5173/
SHARE_BASE_URL=http://localhost:5173/
CRON_SECRET=integration-cron-secret

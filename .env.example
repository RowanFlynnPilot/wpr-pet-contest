# Edge function secrets. Copy to .env for local development
# (`supabase functions serve --env-file .env`). .env is gitignored — keep it that way.
#
# In production these are edge function secrets, NOT a file:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically, both by `supabase functions serve` and in production.

# ---------------------------------------------------------------- required --
# Use the contest's own Stripe account, not WPR's donation account.
# See README, "Why a separate Stripe account".
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Exact origin(s) the front end is served from, comma-separated. Never "*" — a
# wildcard would let any site on the internet create payment intents against
# your Stripe account, and the functions refuse to start with one.
ALLOWED_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- optional --
# Where links in emails point: the WordPress page embedding the contest, and
# the GitHub Pages site holding the per-pet share pages.
PUBLIC_URL=https://wausaupilotandreview.com/cutest-pet/
SHARE_BASE_URL=https://rowanflynnpilot.github.io/wpr-pet-contest/

# Entries allowed per email address per contest (rejected ones do not count).
MAX_ENTRIES_PER_EMAIL=5

# ------------------------------------------------------------------- email --
# Leave RESEND_API_KEY empty and email stays off: nothing is sent, and the admin
# panel reports how many messages are waiting. See README, "Email".
RESEND_API_KEY=
EMAIL_FROM=Wausau Pilot & Review <pets@wausaupilotandreview.com>
EMAIL_REPLY_TO=

# Lets .github/workflows/notify.yml run the sweep on a schedule. Any long random
# string; set the same value as a GitHub Actions secret.
CRON_SECRET=

# Copy to .env for local development. .env is gitignored — keep it that way.
#
# In production these are edge function secrets, NOT a file:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# deployed edge functions. You only need them locally.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Use the contest's own Stripe account, not WPR's donation account.
# See README, "Why a separate Stripe account".
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Exact origin the front end is served from. Never "*" — a wildcard lets any
# site on the internet create payment intents against your Stripe account.
ALLOWED_ORIGIN=http://localhost:5173
